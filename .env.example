# NoWorryCV local config
# Copy to `.env` and fill in your own values.

APP_NAME=NoWorryCV API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
PROMPT_VERSION=v1

# Anonymous data lifecycle and abuse protection
ANONYMOUS_RUN_TTL_HOURS=24
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TASK_QUEUE_PATH=.dist/task_queue.sqlite3
TASK_WORKER_COUNT=1
TASK_MAX_ATTEMPTS=3
CANDIDATE_ARCHIVE_PATH=.dist/candidate_archives.sqlite3
APPLICATION_STORE_PATH=.dist/applications.sqlite3

# Provider selection: stub | qwen | openai_compatible
LLM_PROVIDER=openai_compatible
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# DeepSeek official API (default). Use a DeepSeek key, not a DashScope key.
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key

# Alternative: select LLM_PROVIDER=qwen to use Qwen / DashScope.
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Official DashScope env naming is also supported.
# DASHSCOPE_API_KEY=your_qwen_api_key
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Generic OpenAI-compatible config remains available if you need it.
# LLM_API_KEY=your_api_key
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

QUALITY_STORE_PATH=.dist/quality.sqlite3

INTERVIEW_STORE_PATH=.dist/interviews.sqlite3
